<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.segovia.reservahotel.controllers.ReservasController"
      spacing="15" style="-fx-padding: 20;">

    <Label text="Gestión de Reservas" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Tabla de Gestión de Reservas -->
    <TableView fx:id="tablaReservas" prefHeight="250" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIdReserva" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
            <TableColumn fx:id="colFechaInicio" text="Llegada" prefWidth="120"/>
            <TableColumn fx:id="colFechaFin" text="Salida" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
            <TableColumn fx:id="colAbono" text="Abono ($)" prefWidth="100"/>
            <TableColumn fx:id="colPrecioTotal" text="Precio Total ($)" prefWidth="120"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>

    <!-- Botones de Acción para la Tabla -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Confirmar Pago" onAction="#onConfirmarPago" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
        <Button text="Anular Reserva" onAction="#onAnularReserva" style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
        <Button text="Borrar Reserva" onAction="#onBorrarReserva" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
        <Button text="Limpiar Formulario" onAction="#onLimpiarFormulario" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <!-- Formulario para Crear/Editar Reservas -->
    <Label text="Detalles de la Reserva (Crear o Editar)" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="25.0" />
            <ColumnConstraints percentWidth="25.0" />
            <ColumnConstraints percentWidth="25.0" />
            <ColumnConstraints percentWidth="25.0" />
        </columnConstraints>

        <ComboBox fx:id="cbCliente" promptText="Seleccionar Cliente" maxWidth="Infinity" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpInicio" promptText="Fecha de Inicio" maxWidth="Infinity" GridPane.columnIndex="1"/>
        <DatePicker fx:id="dpFin" promptText="Fecha de Fin" maxWidth="Infinity" GridPane.columnIndex="2"/>
        <TextField fx:id="txtAbono" promptText="Abono ($)" maxWidth="Infinity" GridPane.columnIndex="3"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="cbHabitacion" promptText="Habitaciones Libres" prefWidth="200"/>
        <Button text="Añadir Habitación" onAction="#onAgregarHabitacion" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
    </HBox>

    <ListView fx:id="listHabitacionesSeleccionadas" prefHeight="150"/>

    <Button text="Guardar Nueva Reserva" onAction="#onGuardarReserva" maxWidth="Infinity" style="-fx-background-color: #0e4c52; -fx-text-fill: white; -fx-font-size: 14px;"/>

</VBox>
