<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.segovia.reservahotel.controllers.InicioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Resumen" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="50.0">
        <VBox alignment="CENTER" style="-fx-background-color: #e8f4f8; -fx-padding: 20; -fx-background-radius: 10;">
            <Label text="Clientes Registrados" style="-fx-font-size: 16px;"/>
            <Label fx:id="lblClientes" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox alignment="CENTER" style="-fx-background-color: #e8f4f8; -fx-padding: 20; -fx-background-radius: 10;">
            <Label text="Habitaciones Totales" style="-fx-font-size: 16px;"/>
            <Label fx:id="lblHabitaciones" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox alignment="CENTER" style="-fx-background-color: #e8f4f8; -fx-padding: 20; -fx-background-radius: 10;">
            <Label text="Reservas Activas" style="-fx-font-size: 16px;"/>
            <Label fx:id="lblReservas" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

</VBox>
