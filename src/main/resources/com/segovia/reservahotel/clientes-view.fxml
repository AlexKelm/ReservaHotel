<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.segovia.reservahotel.controllers.ClientesController" spacing="15" style="-fx-padding: 20;">

    <Label text="Gestión de Clientes" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaClientes" prefHeight="300" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colApellido" text="Apellido" prefWidth="150"/>
            <TableColumn fx:id="colDni" text="DNI" prefWidth="100"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>

    <Separator/>

    <Label text="Datos del Cliente" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="33.3"/>
            <ColumnConstraints percentWidth="33.3"/>
            <ColumnConstraints percentWidth="33.3"/>
        </columnConstraints>

        <TextField fx:id="txtNombre" promptText="Nombre" GridPane.columnIndex="0"/>
        <TextField fx:id="txtApellido" promptText="Apellido" GridPane.columnIndex="1"/>
        <TextField fx:id="txtDni" promptText="DNI" GridPane.columnIndex="2"/>
        <TextField fx:id="txtTelefono" promptText="Teléfono" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEmail" promptText="Email" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <ComboBox fx:id="cbTipo" promptText="Tipo de Cliente" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Guardar" onAction="#onGuardar" style="-fx-background-color: #0e4c52; -fx-text-fill: white;"/>
        <Button text="Eliminar" onAction="#onEliminar" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
        <Button text="Limpiar" onAction="#onLimpiar" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
    </HBox>

</VBox>
