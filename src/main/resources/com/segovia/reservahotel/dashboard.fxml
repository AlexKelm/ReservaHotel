<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.segovia.reservahotel.controllers.DashboardController"
            prefWidth="1200" prefHeight="700"
            style="-fx-background-color: #f5f6fa;">

    <!-- ========== SIDEBAR IZQUIERDA ========== -->
    <left>
        <VBox spacing="20" alignment="TOP_CENTER" prefWidth="240"
              style="-fx-background-color: #0e4c52; -fx-padding: 25;">

            <Label text="ReservaHotel"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />

            <Separator/>

            <Button fx:id="btnInicio" text="🏠 Inicio" prefWidth="200"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"
                    onAction="#mostrarInicio"/>

            <Button fx:id="btnClientes" text="👤 Clientes" prefWidth="200"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"
                    onAction="#mostrarClientes"/>

            <Button fx:id="btnHabitaciones" text="🛏️ Habitaciones" prefWidth="200"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"
                    onAction="#mostrarHabitaciones"/>

            <Button fx:id="btnReservas" text="📅 Reservas" prefWidth="200"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"
                    onAction="#mostrarReservas"/>

            <Button fx:id="btnUsuarios" text="🔑 Usuarios" prefWidth="200"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"
                    onAction="#mostrarUsuarios"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnSalir" text="🚪 Cerrar sesión" prefWidth="200"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px;"
                    onAction="#cerrarSesion"/>
        </VBox>
    </left>

    <!-- ========== ENCABEZADO SUPERIOR ========== -->
    <top>
        <HBox spacing="10" alignment="CENTER_RIGHT" prefHeight="50"
              style="-fx-background-color: white; -fx-padding: 10 20 10 10; -fx-border-color: #ddd;">

            <Label fx:id="lblUsuarioActivo" text="Usuario: admin"
                   style="-fx-text-fill: #333; -fx-font-size: 14px;"/>
        </HBox>
    </top>

    <!-- ========== CONTENEDOR CENTRAL ========== -->
    <center>
        <StackPane fx:id="mainContent" style="-fx-padding: 20;">
            <Label text="Bienvenido al sistema de reservas"
                   style="-fx-font-size: 18px; -fx-text-fill: #333;"/>
        </StackPane>
    </center>
</BorderPane>