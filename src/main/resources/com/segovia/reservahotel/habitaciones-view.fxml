<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.segovia.reservahotel.controllers.HabitacionesController"
      spacing="10">
    <children>
        <Label text="Gestión de Habitaciones" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <TableView fx:id="tablaHabitaciones" prefHeight="250">
            <columns>
                <TableColumn text="ID" fx:id="colId" prefWidth="50"/>
                <TableColumn text="Capacidad" fx:id="colCapacidad" prefWidth="80"/>
                <TableColumn text="Cama" fx:id="colCama" prefWidth="100"/>
                <TableColumn text="Caract." fx:id="colCaract" prefWidth="100"/>
                <TableColumn text="Precio" fx:id="colPrecio" prefWidth="80"/>
                <TableColumn text="Estado" fx:id="colEstado" prefWidth="80"/>
            </columns>
        </TableView>
        <HBox spacing="10">
            <TextField fx:id="txtCapacidad" promptText="Capacidad"/>
            <ComboBox fx:id="cbTipoCama" promptText="Tipo cama"/>
            <ComboBox fx:id="cbCaracteristica" promptText="Característica"/>
        </HBox>
        <HBox spacing="10">
            <TextField fx:id="txtPrecio" promptText="Precio"/>
            <ComboBox fx:id="cbEstado" promptText="Estado"/>
        </HBox>
        <HBox spacing="10">
            <Button text="Guardar" onAction="#onGuardar"/>
            <Button text="Editar" onAction="#onEditar"/>
            <Button text="Eliminar" onAction="#onEliminar"/>
        </HBox>
    </children>
</VBox>