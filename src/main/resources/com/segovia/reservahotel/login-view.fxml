<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.segovia.reservahotel.controllers.LoginController"
            prefWidth="400.0" prefHeight="250.0">
    <children>
        <VBox spacing="10" alignment="CENTER"
              AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            <children>
                <Label text="Login - Hotel"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtUsuario" promptText="Usuario" maxWidth="220"/>
                <PasswordField fx:id="txtPassword" promptText="Contraseña" maxWidth="220"/>
                <Label fx:id="lblMensaje" textFill="red"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Ingresar" onAction="#onLogin"/>
                    <Button text="Cancelar" onAction="#onCancelar"/>
                </HBox>
            </children>
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        </VBox>
    </children>
</AnchorPane>