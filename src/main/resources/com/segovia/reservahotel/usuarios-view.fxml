<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.segovia.reservahotel.controllers.UsuariosController"
      spacing="10" style="-fx-background-color: white;"
      prefWidth="800" prefHeight="500">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Gestión de Usuarios"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaUsuarios" prefHeight="250">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colUsername" text="Usuario" prefWidth="150"/>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="130"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <TextField fx:id="txtUsername" promptText="Usuario" prefWidth="150"/>
        <PasswordField fx:id="txtPassword" promptText="Contraseña" prefWidth="150"/>

        <ComboBox fx:id="cbRol" promptText="Rol" prefWidth="140"/>

        <Button text="Nuevo" onAction="#onNuevo"/>
        <Button text="Guardar" onAction="#onGuardar"/>
        <Button text="Eliminar" onAction="#onEliminar"/>
    </HBox>

    <Label fx:id="lblMensaje" textFill="red"/>

</VBox>